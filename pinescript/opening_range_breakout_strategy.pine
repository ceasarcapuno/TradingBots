// =============================================================================
// Opening Range Breakout Strategy — TradingView Pine Script v5
// Generates webhook alerts for the autonomous trading system
// =============================================================================
// Deploy: Add to ES/NQ chart (1-min or 5-min timeframe)
// The strategy tracks the first 15 minutes of RTH to define the range
// =============================================================================

//@version=5
strategy("ORB Breakout [Webhook]", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=50000, commission_value=2.5,
     slippage=1, process_orders_on_close=false)

// ─── Inputs ──────────────────────────────────────────────────────────────────
rangePeriodMin   = input.int(15, "Opening Range Period (minutes)", minval=5, maxval=60)
atrPeriod        = input.int(14, "ATR Period")
minRangeATR      = input.float(0.5, "Min Range Width (ATR)", step=0.1)
maxRangeATR      = input.float(3.0, "Max Range Width (ATR)", step=0.1)
breakoutBuffer   = input.float(0.50, "Breakout Buffer (points)", step=0.25)
volumeSurge      = input.float(1.3, "Volume Surge Ratio", step=0.1)
trailingStopATR  = input.float(1.5, "Trailing Stop (ATR)", step=0.1)
webhookToken     = input.string("YOUR_SECRET_TOKEN", "Webhook Auth Token")

// ─── Session Definitions ────────────────────────────────────────────────────
// Opening range window: 8:30-8:45 CT
isOpeningRange = not na(time(timeframe.period, "0830-0845", "America/Chicago"))
// Breakout trading window: 8:45-11:00 CT
isBreakoutWindow = not na(time(timeframe.period, "0845-1100", "America/Chicago"))
// Full session for exits: 8:30-14:45 CT
inSession = not na(time(timeframe.period, "0830-1445", "America/Chicago"))

// ─── Indicators ─────────────────────────────────────────────────────────────
atrValue    = ta.atr(atrPeriod)
volumeAvg   = ta.sma(volume, 20)
volumeRatio = volume / volumeAvg

// ─── Opening Range Tracking ─────────────────────────────────────────────────
var float rangeHigh = na
var float rangeLow  = na
var bool  rangeSet  = false
var bool  tradedToday = false

// Reset at start of opening range period each day
if isOpeningRange and not isOpeningRange[1]
    rangeHigh  := high
    rangeLow   := low
    rangeSet   := false
    tradedToday := false

// Update range during opening period
if isOpeningRange
    rangeHigh := math.max(rangeHigh, high)
    rangeLow  := math.min(rangeLow, low)

// Lock range when opening period ends
if not isOpeningRange and isOpeningRange[1]
    rangeSet := true

// ─── Range Validation ───────────────────────────────────────────────────────
rangeWidth   = rangeHigh - rangeLow
rangeATR     = atrValue > 0 ? rangeWidth / atrValue : 0
validRange   = rangeSet and rangeATR >= minRangeATR and rangeATR <= maxRangeATR

// ─── Breakout Conditions ────────────────────────────────────────────────────
noOpenTrade  = strategy.position_size == 0

longBreakout = isBreakoutWindow and validRange and noOpenTrade and
     not tradedToday and
     close > rangeHigh + breakoutBuffer and
     volumeRatio >= volumeSurge

shortBreakout = isBreakoutWindow and validRange and noOpenTrade and
     not tradedToday and
     close < rangeLow - breakoutBuffer and
     volumeRatio >= volumeSurge

// ─── Trade Execution ────────────────────────────────────────────────────────
longStop    = rangeLow
longTarget  = close + math.min(rangeWidth * 2, atrValue * 4)
shortStop   = rangeHigh
shortTarget = close - math.min(rangeWidth * 2, atrValue * 4)

if longBreakout
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=longStop, limit=longTarget,
         trail_offset=atrValue * trailingStopATR / syminfo.mintick,
         trail_points=atrValue / syminfo.mintick)
    tradedToday := true

if shortBreakout
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=shortStop, limit=shortTarget,
         trail_offset=atrValue * trailingStopATR / syminfo.mintick,
         trail_points=atrValue / syminfo.mintick)
    tradedToday := true

// Force exit at end of session
if not inSession and strategy.position_size != 0
    strategy.close_all("Session End")

// ─── Webhook Alert Messages ─────────────────────────────────────────────────
confidence = math.min(0.85, 0.5 + (volumeRatio - 1) * 0.2)

longMsg = '{"token":"' + webhookToken + '","strategy":"opening_range_breakout","action":"long_entry","instrument":"{{ticker}}","price":{{close}},"stop_loss":' + str.tostring(longStop, "#.##") + ',"take_profit":' + str.tostring(longTarget, "#.##") + ',"confidence":' + str.tostring(confidence, "#.##") + ',"timestamp":"{{time}}","metadata":{"range_high":' + str.tostring(rangeHigh, "#.##") + ',"range_low":' + str.tostring(rangeLow, "#.##") + '}}'

shortMsg = '{"token":"' + webhookToken + '","strategy":"opening_range_breakout","action":"short_entry","instrument":"{{ticker}}","price":{{close}},"stop_loss":' + str.tostring(shortStop, "#.##") + ',"take_profit":' + str.tostring(shortTarget, "#.##") + ',"confidence":' + str.tostring(confidence, "#.##") + ',"timestamp":"{{time}}","metadata":{"range_high":' + str.tostring(rangeHigh, "#.##") + ',"range_low":' + str.tostring(rangeLow, "#.##") + '}}'

exitMsg = '{"token":"' + webhookToken + '","strategy":"opening_range_breakout","action":"flatten","instrument":"{{ticker}}","price":{{close}},"timestamp":"{{time}}"}'

if longBreakout
    alert(longMsg, alert.freq_once_per_bar)
if shortBreakout
    alert(shortMsg, alert.freq_once_per_bar)
if not inSession and strategy.position_size[1] != 0 and strategy.position_size == 0
    alert(exitMsg, alert.freq_once_per_bar)

// ─── Visual ─────────────────────────────────────────────────────────────────
rangeColor = rangeSet ? (validRange ? color.new(color.blue, 80) : color.new(color.gray, 80)) : color.new(color.yellow, 80)

plot(rangeSet ? rangeHigh : na, "Range High", color=color.green,
     style=plot.style_linebr, linewidth=2)
plot(rangeSet ? rangeLow : na, "Range Low", color=color.red,
     style=plot.style_linebr, linewidth=2)

bgcolor(isOpeningRange ? color.new(color.yellow, 90) : na, title="Opening Range Period")
bgcolor(isBreakoutWindow and validRange ? color.new(color.blue, 95) : na, title="Breakout Window")

plotshape(longBreakout, "Long Breakout", shape.arrowup,
     location.belowbar, color.green, size=size.normal)
plotshape(shortBreakout, "Short Breakout", shape.arrowdown,
     location.abovebar, color.red, size=size.normal)
