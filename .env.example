# =============================================================================
# Autonomous Trading System — Environment Configuration
# Copy to .env and fill in your values
# =============================================================================

# --- System ---
SYS_DRY_RUN=true
SYS_LOG_LEVEL=INFO
SYS_TOTAL_ACCOUNTS=20

# --- Webhook Server ---
WEBHOOK_SECRET_TOKEN=your_webhook_secret_here
WEBHOOK_PORT=8443
WEBHOOK_SSL_CERT_PATH=
WEBHOOK_SSL_KEY_PATH=

# --- Tradovate API ---
TRADOVATE_USE_DEMO=true
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_CID=
TRADOVATE_SEC=

# --- Risk Overrides (optional — defaults are conservative) ---
# RISK_MAX_DAILY_LOSS_ABSOLUTE=500
# RISK_MAX_SINGLE_TRADE_RISK=150
# RISK_DRAWDOWN_CRITICAL_PCT=0.70

# --- Copy Trading ---
COPY_MIN_DELAY_MS=500
COPY_MAX_DELAY_MS=5000
COPY_SIZE_VARIANCE_PCT=0.20
COPY_SKIP_PROBABILITY=0.10

# --- Apex Rule Overrides (only if Apex changes rules) ---
# APEX_EVAL_PROFIT_TARGET=3000
# APEX_EVAL_MAX_DRAWDOWN=2500
